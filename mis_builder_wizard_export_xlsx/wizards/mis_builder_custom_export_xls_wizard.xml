<odoo>

    <record model="ir.ui.view" id="mis_builder_custom_export_xls_wizard_form_view">
        <field
            name="name"
        >mis.builder.custom.export.xls.wizard.form (in ebt_mis_builder_custom_export_xls)</field>
        <field name="model">mis.builder.custom.export.xls.wizard</field>
        <field name="arch" type="xml">
            <form string="Mis Builder Custom Export Xls Wizard">
                <group>
                    <field
                        name="company_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                    <field name="compute_report_company_by_company" />
                    <field name="wizard_line_ids">
                        <tree create="1" edit="1" editable="top">
                            <field name="report_id" options="{'no_open': True}" />
                            <field name="date" />
                        </tree>
                    </field>

                </group>
                <footer>
                    <button
                        name="export"
                        string="Export"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="mis_builder_custom_export_xls_wizard_act_window"
    >
        <field name="name">Mis Builder Custom Export Xls Wizard</field>
        <field name="res_model">mis.builder.custom.export.xls.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <record model="ir.actions.server" id="mis_builder_custom_export_xls_wizard_action">
        <field name="name">Custom Export XLS</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="binding_model_id" ref="mis_builder.model_mis_report_instance" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.open_wizard_custom_export_xls()
        </field>
    </record>


</odoo>
