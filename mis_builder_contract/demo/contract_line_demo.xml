<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="contract_contract_customer" model="contract.contract">
        <field name="name">Demo Customer Contract</field>
        <field name="partner_id" ref="base.res_partner_1" />
        <field name="contract_type">sale</field>
    </record>
    <record id="contract_line_customer" model="contract.line">
        <field name="contract_id" ref="contract_contract_customer" />
        <field name="product_id" ref="product.product_product_4" />
        <field name="name">Product Demo 4</field>
        <field name="price_unit">10</field>
        <field name="date_start">2025-01-01</field>
    </record>
    <record id="contract_contract_supplier" model="contract.contract">
        <field name="name">Demo Supplier Contract</field>
        <field name="partner_id" ref="base.res_partner_1" />
        <field name="contract_type">purchase</field>
    </record>
    <record id="contract_line_supplier" model="contract.line">
        <field name="contract_id" ref="contract_contract_supplier" />
        <field name="product_id" ref="product.product_product_4" />
        <field name="name">Product Demo 4</field>
        <field name="price_unit">10</field>
        <field name="date_start">2025-01-01</field>
    </record>
</odoo>
